
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
CARSI_URL=your_carsi_login_url_here
CARSI_USERNAME=your_carsi_username
CARSI_PASSWORD=your_carsi_password
OUTPUT_DIR=../output

# NCBI E-utilities API key（可选但强烈建议）
# 无 key 限速 3 次/秒，有 key 提升到 10 次/秒；在 https://www.ncbi.nlm.nih.gov/account/ 免费申请
NCBI_API_KEY=

# CORS 允许的来源（可选，逗号分隔，不含通配符）
# 默认仅允许 http://localhost:8000 和 http://127.0.0.1:8000
# 如需局域网使用，例如：http://192.168.1.100:8000,http://example.com
ALLOWED_ORIGINS=
